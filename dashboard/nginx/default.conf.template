server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Runtime config and the SPA shell must never be cached: env.js changes per
  # deployment and index.html references content-hashed bundles.
  location = /env.js {
    add_header Cache-Control "no-store";
  }
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # Hashed bundles are immutable by construction.
  location ~* \.(js|css|ico|png|svg|woff2?)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
